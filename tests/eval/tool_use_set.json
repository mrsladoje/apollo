{
  "version": 1,
  "description": "ADR-022 live tool-use eval: model must choose a tool, provide valid args, use returned telemetry, cite rows, and refuse unsupported questions.",
  "items": [
    {
      "id": "tool-query-nozzle",
      "question": "What was the nozzle health in run barcelona-humid-ai-seed0042 at 2026-04-25T08:00:00?",
